{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./packages/math/src",
    "./packages/ui/src",
    "./packages/backend/convex"
  ],
  "entryPointStrategy": "expand",
  "out": "./docs",
  "name": "Aivar Documentation",
  "readme": "./README.md",
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "includeVersion": true,
  "categorizeByGroup": true,
  "sort": ["source-order"],
  "navigationLinks": {
    "GitHub": "https://github.com/chauhan-varun/Aivar"
  },
  "skipErrorChecking": true
}

